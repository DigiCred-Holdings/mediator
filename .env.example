POSTGRES_HOST=localhost
POSTGRES_ACCOUNT=youruser
POSTGRES_PASSWORD=yourpassword
POSTGRES_ADMIN_ACCOUNT=youruser
POSTGRES_ADMIN_PASSWORD=yourpassword

# --- Push notifications (optional) ---
# Base64-encoded Firebase service-account JSON. When set, the mediator sends an
# FCM/APNs push to offline recipients on a new message. Leave empty to disable.
SERVICE_ACCOUNT=

# HTTP listen port for the control API (Swagger + /start, /invite, /oob-invite)
PORT=3000

# --- Mediator pickup queue ---
# Where queued messages live: 'askar' persists them to the wallet DB (survives
# restart, default) or 'memory' (faster, lost on restart).
QUEUE_PERSISTENCE=askar
# Process inbound DIDComm messages concurrently (overlapping async I/O) instead
# of strictly one-at-a-time. Node stays single-threaded; this removes the serial
# bottleneck. Set to false for strictly serial processing (more backpressure).
PROCESS_MESSAGES_CONCURRENTLY=true

# --- Mediator message-queue DoS limits ---
# Max pending pickup messages per mediated connection.
MAX_QUEUE_PER_CONNECTION=200
# Max pending pickup messages across all connections.
MAX_QUEUE_TOTAL=50000
# Max total bytes of queued messages per connection (guards against a few large
# messages exhausting memory). Default 20MB.
MAX_QUEUE_BYTES_PER_CONNECTION=20971520
# Max total bytes of queued messages across all connections. Default 500MB.
MAX_QUEUE_BYTES_TOTAL=524288000
# Max size (bytes) of a single queued message. Default 5MB (matches HTTP body cap).
MAX_MESSAGE_BYTES=5242880
# Evict queued messages older than this many ms. Default 1 week; set 0 to disable.
QUEUE_MESSAGE_TTL_MS=604800000
# Overflow behaviour when a queue is full: drop-oldest (default) or reject.
QUEUE_OVERFLOW_STRATEGY=drop-oldest
# Max size (bytes) of a single inbound WebSocket frame. Defaults to 5MB to match
# the HTTP transport's body cap.
MAX_WS_PAYLOAD_BYTES=5242880

# --- Abuse detection (per-connection forward rate limiting) ---
# Sliding window (ms) over which a connection's forward rate is measured.
ABUSE_WINDOW_MS=10000
# Max forwards per connection per window before it is blocked as abusive.
ABUSE_MAX_PER_WINDOW=500
# How long (ms) a flagged connection stays blocked (forwards rejected).
ABUSE_BLOCK_DURATION_MS=60000
